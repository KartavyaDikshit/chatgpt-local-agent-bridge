# Auth is required by default.
BRIDGE_AUTH_TOKEN=replace-with-a-long-random-local-token

# Loopback-only development mode. Keep false unless testing locally.
ALLOW_NO_AUTH_LOOPBACK=false

# Local server bind settings.
HOST=127.0.0.1
PORT=8787

# Workspace sandbox. Relative paths resolve inside the project folder.
LOCAL_BRIDGE_WORKSPACE=./sandbox-workspace

# Optional OpenAI-compatible local runtime, such as LM Studio.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_REQUEST_TIMEOUT_MS=30000

# Command allowlist config.
ALLOWED_COMMANDS_CONFIG=./config/allowed_commands.example.json
